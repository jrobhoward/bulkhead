#!/bin/sh
#
# Bulkhead under its privileged helper (OPERATIONS.md, "The privileged
# helper"): rc starts bulkhead-priv as root; it starts the node as the
# node's user and every app instance under a user of the app's own.
#
#   install -m 0555 examples/freebsd/bulkhead /usr/local/etc/rc.d/bulkhead
#   (and the helper's configuration at /usr/local/etc/bulkhead/priv.conf,
#   as examples/systemd/priv.conf but with no cgroup)
#   sysrc bulkhead_enable=YES && service bulkhead start
#
# node.toml sets [priv] and [native] runner to the helper's runner,
# beside which the node finds bulkhead-resolve (and bulkhead-ingress).
#
# PROVIDE: bulkhead
# REQUIRE: NETWORKING
# KEYWORD: shutdown

. /etc/rc.subr

name=bulkhead
rcvar=bulkhead_enable
desc="Bulkhead node, under its privileged helper"

load_rc_config $name

: ${bulkhead_enable:="NO"}
: ${bulkhead_config:="/usr/local/etc/bulkhead/priv.conf"}
: ${bulkhead_log:="/var/log/bulkhead.log"}

helper="/usr/local/sbin/bulkhead-priv"
# The supervisor's pid, which stop and status use: daemon(8) restarts the
# helper when it exits (-r, after 2 s), as when it kills a wedged node
# (node_watchdog_s, ROADMAP B6), and on SIGTERM ends it and exits.
pidfile="/var/run/${name}.pid"
# The helper's own pid, which reload signals: it passes SIGHUP to the
# node; it passes SIGTERM on too, so the node stops its apps and exits.
helper_pidfile="/var/run/${name}-priv.pid"
command="/usr/sbin/daemon"
command_args="-f -r -R 2 -P ${pidfile} -p ${helper_pidfile} -o ${bulkhead_log} ${helper} ${bulkhead_config}"
extra_commands="reload"
reload_cmd="${name}_reload"
sig_stop="TERM"

bulkhead_reload()
{
	kill -HUP "$(cat "${helper_pidfile}")"
}

run_rc_command "$1"
